# ── OpenAI (execution layer only — confirms price/balance, places the order) ──
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Disable OpenAI Agents SDK tracing to OpenAI platform (set 1 to disable)
# OPENAI_AGENTS_DISABLE_TRACING=0

# ── Jev decision layer (TypeSafe System One via OpenRouter Decisions API) ─────
# dry-run = deterministic, offline, keyless (default; safe for local/dev/CI)
# openrouter = real Jev call — requires OPENROUTER_API_KEY
DECISION_PROVIDER=dry-run
JEV_MODEL=typesafe/jev-1.13
JEV_CONFIDENCE_GATE=0.7
OPENROUTER_API_KEY=sk-or-...

# ── Coinbase Exchange API ─────────────────────────────────────────────────────
# Generate at https://www.coinbase.com/settings/api
COINBASE_API_KEY=your-api-key
COINBASE_API_SECRET=your-base64-encoded-secret
COINBASE_API_PASSPHRASE=your-passphrase
USE_SANDBOX=false

# ── Monitoring target ─────────────────────────────────────────────────────────
COIN=BTC-USD
TARGET_PRICE_USD=60000
POLL_INTERVAL_SECONDS=60

# ── Buy guardrails ────────────────────────────────────────────────────────────
MIN_BUY_USD=10.0
MAX_BUY_USD=500.0
MAX_DAILY_SPEND_USD=1000.0
MAX_TOTAL_SPEND_USD=5000.0
MAX_BUYS_PER_HOUR=3
MAX_PRICE_DRIFT_PCT=1.0

# ── Behaviour ─────────────────────────────────────────────────────────────────
# REQUIRE_APPROVAL=false   # prompt for confirmation before each buy
# DRY_RUN=false            # log intended actions without executing orders

# ── Email notifications ───────────────────────────────────────────────────────
# Leave blank to disable email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFY_EMAIL=alerts@example.com

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Leave blank to print spans/metrics to stdout
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=crypto-buying-agent

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
JSON_LOGS=true

# ── State persistence ─────────────────────────────────────────────────────────
# Default: ~/.crypto-buying-agent/
# STATE_DIR=/var/lib/crypto-agent
